    {
      "parameters": {
        "jsCode": "// Loop through incoming items and format fields as Q&A pairs\nconst newItems = [];\n\nfor (const item of $input.all()) {\n  const qaPairs = Object.entries(item.json).map(([question, answer]) => {\n    return {\n      question: question,\n      answer: answer\n    };\n  });\n\n  // Push an item containing the array of questions and answers\n  newItems.push({ json: { qaPairs } });\n}\n\nreturn newItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1264,
        -336
      ],
      "id": "94f25d21-dea0-4249-b399-21b2e5763cc3",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        -1072,
        -336
      ],
      "id": "ea84691b-8835-40c1-b4a1-a2af0bd64b5e",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "// 1. Grab the incoming item\nconst items = $input.all();\nconst firstItem = items[0]?.json;\n\n// 2. Safely navigate to the nested qaPairs array\nconst qaPairs = firstItem?.data?.[0]?.qaPairs || [];\n\n// 3. Loop through pairs, format them, and filter out metadata questions\nconst formattedPairs = qaPairs\n  .filter(item => item.question !== 'submittedAt' && item.question !== 'formMode')\n  .map(item => `Question: ${item.question} Answer: ${item.answer}`);\n\n// 4. Join all pairs into one big block of text separated by double newlines\nconst textChunk = formattedPairs.join('; ');\n\n// 5. Output the single text chunk\nreturn [{\n  json: {\n    medicalHistoryBlock: textChunk\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
